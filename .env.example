# Copy to .env.local: scripts/base-stack.sh and docker-compose.base.yml read it. The script sets the deploy inputs
# (ids, prices, ports) itself; this file holds the keys and the RPC.

# ── chain ────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org     # the services poll every second: a private RPC rate-limits less
INFURA_API_KEY=                                   # used when BASE_SEPOLIA_RPC_URL is unset
HL_INFO_API_URL=https://api.hyperliquid-testnet.xyz/info

# ── keys (never commit) ──────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=                             # deploys and owns everything; the bots' oracle/pool account (Base Sepolia ETH)
KEEPER_PRIVATE_KEY=                               # pays gas only, holds no vault funds (Base Sepolia ETH)
BASE_HEDGE_PRIVATE_KEY=                           # the hedge account on HyperCore (holds the short): its own key
BASE_RELAYER_PRIVATE_KEY=                         # the gateway's relayer on Base (Base Sepolia ETH); default BASE_HEDGE_PRIVATE_KEY
BASE_MM_PRIVATE_KEY=                              # bots' HyperCore market maker: its own account, not the hedge account
FAUCET_OPERATOR_PRIVATE_KEY=                      # API's faucet relay (Faucet.setOperator); pays testers' drip gas
CRE_PRIVATE_KEY=                                  # pays the CRE report writes (cre-loop), so it never races the deployer's nonce

# ── Chainlink Data Streams (CRE market status) ───────────────────────────
DATA_STREAMS_API_KEY=
DATA_STREAMS_USER_SECRET=

# ── off-chain services ───────────────────────────────────────────────────
TRUST_PROXY=0                                     # API behind a proxy: rate-limit the faucet by x-forwarded-for
ALERT_WEBHOOK_URL=                                # bots' alerts (Discord/Slack incoming webhook); empty → logs only
