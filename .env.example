# ── chain ────────────────────────────────────────────────────────────────
NETWORK=testnet                                   # testnet | mainnet → deployments/<NETWORK>.json
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
HL_INFO_API_URL=https://api.hyperliquid-testnet.xyz/info   # mainnet: https://api.hyperliquid.xyz/info
ETHERSCAN_API_KEY=

# ── keys (never commit) ──────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=                               # pays gas only, holds no vault funds

# ── deploy inputs (fill after spikes 5 & 6) ──────────────────────────────
USDC_ADDRESS=
MORPHO_ADDRESS=
MORPHO_IRM_ADDRESS=
POOL_MANAGER_ADDRESS=
NVDAX_ADDRESS=
PERP_DEX_INDEX=                                   # from info API `perpDexs`
PERP_ASSET=                                       # 100000 + PERP_DEX_INDEX*10000 + indexInMeta
SZ_DECIMALS=

# ── off-chain services ───────────────────────────────────────────────────
API_PORT=8787
REPLAY_TOKEN=change-me                            # guards POST /replay/:step
KEEPER_TICK_MS=1000
NEXT_PUBLIC_API_URL=http://localhost:8787
