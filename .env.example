# ── chain ────────────────────────────────────────────────────────────────
NETWORK=testnet                                   # testnet | mainnet → deployments/<NETWORK>.json
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
HL_INFO_API_URL=https://api.hyperliquid-testnet.xyz/info   # mainnet: https://api.hyperliquid.xyz/info
ETHERSCAN_API_KEY=

# ── keys (never commit) ──────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=                               # pays gas only, holds no vault funds
FAUCET_OPERATOR_PRIVATE_KEY=                      # API's faucet relay (Faucet.setOperator); pays testers' drip gas
HL_MM_PRIVATE_KEY=                                # bots' HyperCore market maker: the account key or an API wallet
HL_MM_ACCOUNT=                                    # the HyperCore account, when HL_MM_PRIVATE_KEY is an API wallet

# ── deploy inputs (fill after spikes 5 & 6) ──────────────────────────────
USDC_ADDRESS=                                     # optional: defaults to Circle USDC for the chain (hyper-evm-lib)
CORE_DEPOSIT_WALLET=                              # optional: defaults to Circle's CoreDepositWallet for the chain
MORPHO_ADDRESS=                                   # testnet: TestnetInfra.s.sol output; mainnet 0x68e37dE8d93d3496ae143F2E900490f6280C57cD
MORPHO_IRM_ADDRESS=                               # testnet: TestnetInfra.s.sol output; mainnet 0xD4a426F010986dCad727e8dd6eed44cA4A9b7483
POOL_MANAGER_ADDRESS=                             # testnet: TestnetInfra.s.sol output; mainnet 0x12D4Fd9C5DeDd00ab8a0bCe2CF0167bbf94b6B1F
NVDAX_ADDRESS=                                    # optional: empty → Deploy.s.sol deploys MockNVDAx
PERP_DEX_INDEX=65                                 # info API `perpDexs`: xyz = 65 on testnet, 1 on mainnet
PERP_ASSET=750002                                 # 100000 + PERP_DEX_INDEX*10000 + indexInMeta (xyz:NVDA = 2); mainnet 110002
SZ_DECIMALS=3                                     # info API `meta` with dex "xyz"
SEED_DEPOSIT=10000000                             # USDC (6 dec) the deployer deposits as the inflation guard
CORE_ACTIVATION=0                                 # testnet 0: its CoreDepositWallet never credits Core (README); mainnet 2000000
START_PRICE_USD6=217000000                        # CreateMarkets: DemoOracle start price, USDC 6 dec

# ── pool seeding (SeedPool.s.sol) ────────────────────────────────────────
THIN=true                                         # true: weekend depth; false: "Monday" deep liquidity
PRICE_USD6=217000000                              # initial pool price, only used on the first run
USDC_AMOUNT=                                      # optional: default 2,000 (thin) / 200,000 (deep) USDC
RANGE_BPS=                                        # optional: default ±3% (thin) / ±10% (deep)

# ── off-chain services ───────────────────────────────────────────────────
API_PORT=8787
POLL_MS=1000                                      # API: snapshot interval
FROM_BLOCK=                                       # API: first block of the activity / bad-debt scan (default: local 0, else head - 10k)
REPLAY_TOKEN=change-me                            # guards POST /replay/:step; testnet/mainnet refuse this default
TRUST_PROXY=0                                     # API behind a proxy: rate-limit the faucet by x-forwarded-for
ALERT_WEBHOOK_URL=                                # bots' alerts (Discord/Slack incoming webhook); empty → logs only
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_NETWORK=testnet                       # the /try page's network
NEXT_PUBLIC_RPC_URL=                              # the /try page's reads; empty → the public testnet RPC
