# Copy to packages/cre/.env (gitignored). Read by `cre workflow simulate`.
# Chainlink Data Streams credentials: the API key is your Data Streams username (UUID), the secret its HMAC secret.
DATA_STREAMS_API_KEY=
DATA_STREAMS_API_SECRET=
# Only for --broadcast: pays the gas of the report write through the simulation forwarder. Needs testnet HYPE.
CRE_ETH_PRIVATE_KEY=
